Package: polle
Title: Policy Learning
Version: 1.6.5
Authors@R: c(person(given = "Andreas",
                    family = "Nordland",
                    role = c("aut", "cre"),
                    email = "andreasnordland@gmail.com"),
             person(given = "Klaus",
                    family = "Holst",
                    role = c("aut"),
